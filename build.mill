package build
import mill._, scalalib._

trait ToolboxModule extends ScalaModule:
  def scalaVersion= "3.3.7"
  def scalacOptions= Seq(
    "-Werror",
    "-release:11",
    "-Ysafe-init",
    "-explain",
    "-deprecation",
    // "-Yexplicit-nulls",
    )
  /*
  object test extends ScalaTests {
    def mvnDeps = Seq(mvn"com.lihaoyi::utest:0.8.4")
    def testFramework = "utest.runner.Framework"
  }
  */

object toolbox extends ToolboxModule:
  def publishVersion= "0.1.0"

  def mvnDeps = Seq(
    mvn"com.lihaoyi::scalatags:0.13.1",
    mvn"com.lihaoyi::mainargs:0.7.8",
    mvn"org.apache.commons:commons-compress:1.27.1",
    )

  inline def copy(from: os.Path, to: os.Path)=
    os.copy(from, to, true, true, true, true, true)

  def wrap= Task.Source("resources/toolbox")

  def release= Task:
    copy(assembly().path, Task.dest / "toolbox" / "toolbox.jar")
    copy(installer.assembly().path, Task.dest / "toolbox" / "installer.jar")
    PathRef(Task.dest)

  def releasePackaged= Task:
    val dest= Task.dest
    copy(releasePackaged_any().path, Task.dest / publishVersion / "any" / "any" / "toolbox.tgz")
    copy(releasePackaged_win_amd64().path, Task.dest / publishVersion / "win" / "amd64" / "toolbox.tgz")
    copy(releasePackaged_win_386().path, Task.dest / publishVersion / "win" / "386" / "toolbox.tgz")
    copy(releasePackaged_win_arm64().path, Task.dest / publishVersion / "win" / "arm64" / "toolbox.tgz")
    copy(releasePackaged_win_arm().path, Task.dest / publishVersion / "win" / "arm" / "toolbox.tgz")
    PathRef(dest)

  def releasePackaged_any= Task:
    val dest= Task.dest / "toolbox.tgz"
    copy(wrap().path, Task.dest / "toolbox" / "toolbox")
    os.call(cmd=("tar", "-czf", dest, "-C", release().path, "toolbox", "-C", Task.dest, "toolbox"))
    os.remove(Task.dest / "toolbox" / "toolbox")
    PathRef(dest)

  def releasePackaged_win_amd64= Task:
    val dest= Task.dest / "toolbox.tgz"
    copy(
      native_aux.autostart.compile().path / "windows" / "amd64" / "cjkv_toolbox_autostart.exe",
      Task.dest / "toolbox" / "cjkv_toolbox_autostart.exe")
    copy(
      native_aux.win_font.compile().path / "windows" / "amd64" / "cjkv_toolbox_win_font.exe",
      Task.dest / "toolbox" / "cjkv_toolbox_win_font.exe")
    os.call(cmd=("tar", "-czf", dest, "-C", release().path, "toolbox", "-C", Task.dest, "toolbox"))
    os.remove(Task.dest / "toolbox" / "cjkv_toolbox_autostart.exe")
    os.remove(Task.dest / "toolbox" / "cjkv_toolbox_win_font.exe")
    PathRef(dest)

  def releasePackaged_win_386= Task:
    val dest= Task.dest / "toolbox.tgz"
    copy(
      native_aux.autostart.compile().path / "windows" / "386" / "cjkv_toolbox_autostart.exe",
      Task.dest / "toolbox" / "cjkv_toolbox_autostart.exe")
    copy(
      native_aux.win_font.compile().path / "windows" / "386" / "cjkv_toolbox_win_font.exe",
      Task.dest / "toolbox" / "cjkv_toolbox_win_font.exe")
    os.call(cmd=("tar", "-czf", dest, "-C", release().path, "toolbox", "-C", Task.dest, "toolbox"))
    os.remove(Task.dest / "toolbox" / "cjkv_toolbox_autostart.exe")
    os.remove(Task.dest / "toolbox" / "cjkv_toolbox_win_font.exe")
    PathRef(dest)

  def releasePackaged_win_arm64= Task:
    val dest= Task.dest / "toolbox.tgz"
    copy(
      native_aux.autostart.compile().path / "windows" / "arm64" / "cjkv_toolbox_autostart.exe",
      Task.dest / "toolbox" / "cjkv_toolbox_autostart.exe")
    os.call(cmd=("tar", "-czf", dest, "-C", release().path, "toolbox", "-C", Task.dest, "toolbox"))
    os.remove(Task.dest / "toolbox" / "cjkv_toolbox_autostart.exe")
    PathRef(dest)

  def releasePackaged_win_arm= Task:
    val dest= Task.dest / "toolbox.tgz"
    copy(
      native_aux.autostart.compile().path / "windows" / "arm" / "cjkv_toolbox_autostart.exe",
      Task.dest / "toolbox" / "cjkv_toolbox_autostart.exe")
    copy(
      native_aux.win_font.compile().path / "windows" / "arm" / "cjkv_toolbox_win_font.exe",
      Task.dest / "toolbox" / "cjkv_toolbox_win_font.exe")
    os.call(cmd=("tar", "-czf", dest, "-C", release().path, "toolbox", "-C", Task.dest, "toolbox"))
    os.remove(Task.dest / "toolbox" / "cjkv_toolbox_autostart.exe")
    os.remove(Task.dest / "toolbox" / "cjkv_toolbox_win_font.exe")
    PathRef(dest)

object installer extends ToolboxModule:
  def publishVersion= "0.1.0"

  def mvnDeps = Seq(
    mvn"com.lihaoyi::scalatags:0.13.1",
    mvn"com.lihaoyi::mainargs:0.7.8",
    )

trait GoCross extends Module:
  def cmd= Task:
    s"go_cross_build ${moduleDir / "cross_build.json"} ${moduleDir} ${Task.dest}"
  def sources = Task.Source { moduleDir }
  def allSources = Task { os.walk(sources().path).map(PathRef(_)) }
  def compile= Task:
    var dependOn= allSources()
    val cross_build= "go_cross_build"
    os.call((cross_build,
      moduleDir / "cross_build.json",
      moduleDir ,
      Task.dest), stdout=os.Inherit)
    PathRef(Task.dest)

object native_aux extends Module:
  object autostart extends GoCross
  object win_font extends GoCross
